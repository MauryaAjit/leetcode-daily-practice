class Solution {
    public int[] numMovesStones(int a, int b, int c) {
        int[] arr = {a, b, c};
        java.util.Arrays.sort(arr);
        int x = arr[0];
        int y = arr[1];
        int z = arr[2];
        int min;
        if (y - x == 1 && z - y == 1) {
            min = 0;
        } else if (y - x <= 2 || z - y <= 2) {
            min = 1;
        } else {
            min = 2;
        }
        int max = (z - x) - 2;
        return new int[]{min, max};
    }
}
