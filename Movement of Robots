class Solution {
    public int sumDistance(int[] nums, String s, int d) {
        int n = nums.length;
        long mod = 1000000007L;
        long[] pos = new long[n];
        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == 'R') {
                pos[i] = (long) nums[i] + d;
            } else {
                pos[i] = (long) nums[i] - d;
            }
        }
        Arrays.sort(pos);
        long result = 0;
        long prefix = 0;
        for (int i = 0; i < n; i++) {
            long contribution =((pos[i] * i) % mod - prefix % mod + mod) % mod;
            result = (result + contribution) % mod;
            prefix = (prefix + pos[i]) % mod;
        }
        return (int) result;
    }
}
