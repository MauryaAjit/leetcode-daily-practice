class Solution {
    vector<int> v;
    
    void update(int x, int y, int d) {
        if (x <= y) {
            v[x - 1] += d;
            v[y] -= d;
        }
    }
public:
    int minMoves(vector<int>& nums, int limit) {
        v.resize(limit + limit + 1);
        const int n = nums.size();
        for (int i = 0, j = n - 1; i < j; ++i, --j) {
            // s - num <= 0
            // s - num >= limit + 1
            const int mini = min(nums[i], nums[j]), maxi = max(nums[i], nums[j]);
            update(2, mini, 2);
            update(mini + limit + 1, maxi, 2);
            update(maxi + limit + 1, limit + limit, 2);
            // s - num >= 1 && s - num <= limit
            update(mini + 1, mini + maxi - 1, 1);
            update(mini + maxi + 1, maxi + limit, 1);
        }
        int r = n;
        for (int i = 1; i < v.size() - 1; ++i) {
            v[i] += v[i - 1];
            r = min(r, v[i]);
        }
        return r;
    }
};
