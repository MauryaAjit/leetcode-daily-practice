class Solution {
    public int findKthPositive(int[] arr, int k) {
        int missingCount = 0;
        int currentNumber = 1;
        int index = 0;

        while (missingCount < k) {
            if (index < arr.length && arr[index] == currentNumber) {
                index++;
            } else {
                missingCount++;
            }
            currentNumber++;
        }

        return currentNumber - 1;
    }
}
