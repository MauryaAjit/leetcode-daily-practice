class Solution {
    public int minImpossibleOR(int[] nums) {
        boolean[]present = new boolean[32];
        for(int num:nums){
            if(num>0&& (num &(num-1))==0)
{
                present[Integer.numberOfTrailingZeros(num)] = true;
            }
        }
        for(int i=0;i<32;i++){
            if(!present[i]){
                return 1<<i;
            }
        }
        return 1<<31;
    }
}
