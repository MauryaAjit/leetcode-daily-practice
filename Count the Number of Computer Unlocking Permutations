class Solution {
    public int countPermutations(int[] complexity) {
        int n = complexity.length;
        long mod = 1000000007L;
        int min = complexity[0];
        for (int i = 1; i < n; i++) {
            if (complexity[i] <= min) {
                return 0;
            }
        }
        long result = 1;
        for (int i = 1; i <= n - 1; i++) {
            result = (result * i) % mod;
        }
        return (int) result;
    }
}
