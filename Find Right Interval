class Solution {

    public int[] findRightInterval(int[][] intervals) {
        int n = intervals.length;
        int[] result = new int[n];
        for (int i = 0; i < n; i++) {
            int end = intervals[i][1];
            int idx = -1;
            int minStart = Integer.MAX_VALUE;
            for (int j = 0; j < n; j++) {
                if (intervals[j][0] >= end &&
                    intervals[j][0] < minStart) {
                    minStart = intervals[j][0];
                    idx = j;
                }
            }

            result[i] = idx;
        }

        return result;
    }
}
